rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can read all, but only write their own
    match /artifacts/{appId}/public/data/users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        // Admins can update other users (for role changes and soft delete)
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin'
      );
      // Admins can soft delete users via update operation (not hard delete)
      allow delete: if false;
    }
    
    // Inventory collection - all authenticated users can read/create/update, only admins can soft delete
    match /artifacts/{appId}/public/data/inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      // Hard delete only allowed for permanent purge by admin (not normal delete operation)
      allow delete: if isAuthenticated() && 
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Logs collection - all authenticated can read/create, admins can update for soft delete, admins can hard delete for cleanup
    match /artifacts/{appId}/public/data/logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Allow updates for soft delete operations by admins
      allow update: if isAuthenticated() && 
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin';
      // Hard delete only for permanent purge by admin
      allow delete: if isAuthenticated() && 
        get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Events collection - all authenticated can read/create/update (for soft delete)/delete (for hard delete)
    match /artifacts/{appId}/public/data/events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}